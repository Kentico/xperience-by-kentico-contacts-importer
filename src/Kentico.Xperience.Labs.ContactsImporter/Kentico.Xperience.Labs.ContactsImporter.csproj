<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Xperience by Kentico Labs: Contacts Importer</Product>
    <Title>$(Product)</Title>
    <Description>Lets marketers import contacts from CSV, Excel, and JSON files into Xperience by Kentico, with deduplication, dry runs, and recipient list assignment.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="CMS.AssemblyDiscoverableAttribute"></AssemblyAttribute>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kentico.Xperience.WebApp" />
  </ItemGroup>

</Project>
