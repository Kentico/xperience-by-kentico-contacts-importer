{
  "name": "contacts-importer-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for the DancingGoat sample and this repository's Xperience extensions.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:live-site": "playwright test --project=live-site",
    "test:admin": "playwright test --project=admin-tests --project=admin-import-runs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "report": "playwright show-report",
    "screenshots": "playwright test -c screenshots.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
